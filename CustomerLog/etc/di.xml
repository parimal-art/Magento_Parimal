<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <virtualType name="Codilar\CustomerLog\Model\Logger\Handler" type="Magento\Framework\Logger\Handler\Base">
        <arguments>
            <argument name="fileName" xsi:type="string">var/log/customer_login.log</argument>
        </arguments>
    </virtualType>

    <virtualType name="Codilar\CustomerLog\Model\Logger" type="Monolog\Logger">
        <arguments>
            <argument name="name" xsi:type="string">customerLoginLogger</argument>
            <argument name="handlers" xsi:type="array">
                <item name="system" xsi:type="object">Codilar\CustomerLog\Model\Logger\Handler</item>
            </argument>
        </arguments>
    </virtualType>

    <type name="Codilar\CustomerLog\Observer\LogCustomerLogin">
        <arguments>
            <argument name="logger" xsi:type="object">Codilar\CustomerLog\Model\Logger</argument>
        </arguments>
    </type>
</config>
