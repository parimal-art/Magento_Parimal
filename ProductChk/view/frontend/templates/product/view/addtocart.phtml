/** @var $escaper \Magento\Framework\Escaper */

$_product = $block->getProduct();
?>
<div class="box-tocart">
    <div class="fieldset">
        <div class="actions">
            <button type="button"
                    title="<?= $escaper->escapeHtmlAttr(__('Product Enquiry')) ?>"
                    class="action primary tocart"
                    id="product-enquiry-btn"
                    data-mage-init='{
                        "Codilar_ProductChk/js/enquiry": {
                            "modalSelector": "#enquiry-modal",
                            "formSelector": "#enquiry-form",
                            "sku": "<?= $escaper->escapeJs($_product->getSku()) ?>",
                            "title": "<?= $escaper->escapeJs(__('Product Enquiry')) ?>"
                        }
                    }'>
                <span><?= $escaper->escapeHtml(__('Product Enquiry')) ?></span>
            </button>
        </div>
