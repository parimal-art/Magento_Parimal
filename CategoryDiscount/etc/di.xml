<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
<!--    final price calculation-->
    <type name="Magento\Catalog\Pricing\Price\FinalPrice">
        <plugin name="codilar_category_discount_pricing_final_price"
                type="Codilar\CategoryDiscount\Plugin\FinalPricePlugin"/>
    </type>
    <!-- Frontend price display -->
    <type name="Magento\Catalog\Pricing\Render\FinalPriceBox">
        <plugin name="codilar_category_discount_price_box"
                type="Codilar\CategoryDiscount\Plugin\PriceBoxPlugin"/>
    </type>
<!--    cart price calculate-->
    <type name="Magento\Catalog\Model\Product\Type\Price">
        <plugin name="codilar_category_discount_product_type_price"
                type="Codilar\CategoryDiscount\Plugin\ProductTypePricePlugin"/>
    </type>
</config>
