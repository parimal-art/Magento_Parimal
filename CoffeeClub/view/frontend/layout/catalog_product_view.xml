<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="product.info.main">
            <block class="Codilar\CoffeeClub\Block\Product\SubscriptionOption"
                   name="coffeeclub.subscription.option"
                   template="Codilar_CoffeeClub::subscription/form.phtml"
                   after="product.info.price">
                <arguments>
                    <argument name="title" xsi:type="string" translate="true">
                        Subscribe &amp; Save
                    </argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
